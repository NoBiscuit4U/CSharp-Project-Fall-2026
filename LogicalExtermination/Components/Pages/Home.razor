@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavMan

<style>
    .content {
        text-align: center;
    }
    .play-btn {
        background-color: rgb(16, 16, 16);
        font-size: 24px;
        padding: 10px 20px; <!-- vertical, horizontal -->
        margin: 10px;
        border: 2px solid white;
        border-radius: 16px;
    }
    .play-btn:hover {
        background-color: white;
        color: black;
        cursor: pointer;
    }
</style>

<div class="content">
    <h1>Logical Extermination</h1>

    <button class="play-btn" type="button" style="color: rgb(0, 200, 0)" @onclick="() => StartGame(0,5)">Easy</button>
    <button class="play-btn" type="button" style="color: orange" @onclick="() => StartGame(25,3)">Medium</button>
    <button class="play-btn" type="button" style="color: rgb(255, 25, 25)" @onclick="() => StartGame(50,1)">Hard</button>

    <p></p>
    <p>Select a difficulty to begin.</p>
</div>

@code {
    private void StartGame(int difficulty, int health)
    {
        Game.setDifficulty(difficulty);
        Game.setHealth(health);
        MainLayout.updateDifColor();
        MainLayout.updateHpColor();
        NavMan.NavigateTo("/play");
    }
}