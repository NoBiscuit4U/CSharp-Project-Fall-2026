@page "/play"
@rendermode InteractiveServer
@using System.Runtime.InteropServices
@using Backend
@using IronPython.Hosting
@inject NavigationManager NavMan

@if (inactiveBricks.Count + activeBricks.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <h2>Squash the Bug</h2>
    <p>@GM.problem</p>
    <div class="AnswerArea">
        <div></div>
        <div class="AnswerSpace">
            <div class="AnswerBlock">
                <div></div>
                <div></div>
                <div class="AnswerPiece">
                    <p>@vars</p>
                </div>
                <div></div>
            </div>
            @for (int i = 0; i < activeBricks.Count; i++)
            {
                int index = i;
                <div class="AnswerBlock">
                    <div>
                        <button class="Act-btn"
                            @onclick="() => { deactivate(index); }">-</button>
                    </div>
                    <div class="Arrows">
                        <button class="Arw-btn"
                            disabled="@(i == 0)"
                            @onclick="() => moveUp(index)">▲</button>
                        <button class="Arw-btn"
                            disabled="@(i == activeBricks.Count - 1)"
                            @onclick="() => moveDown(index)">▼</button>
                    </div>
                    <div class="AnswerPiece">
                        <p>@activeBricks[i].code</p>
                    </div>
                    <div class="VarBlock">
                        @for (int j = 0; j < activeBricks[i].varCount; j++)
                        {
                        int varIndex = j;
                        <select @bind="activeBricks[index].variables[varIndex]" class="VarPiece">
                            <option value=""></option>
                                @foreach (var v in GM.variables)
                                {
                                    <option value="@v">@v</option>
                                }
                            </select>                            
                        }
                    </div>
                </div>
            }
        </div>
        <div></div>
    </div>
    <div style="padding: 20px;">
        <button class="Act-btn";" @onclick="() => CheckAnswer()">Submit</button>
    </div>
    <div class="AnswerArea">
        <div></div>
        <div class="AnswerSpace">
            @for (int i = 0; i < inactiveBricks.Count; i++)
            {
                int index = i;
                <div class="InactiveBlock">
                    <div class="Arrows">
                        <button class="InactiveAct-btn"
                            @onclick="() => activate(index)">+</button>
                    </div>
                    <div class="InactivePiece">
                        <p>@inactiveBricks[i].code</p>
                    </div>
                </div>
            }
        </div>
        <div></div>
    </div>
}

@code {
    [Inject]
    private GameMode GM { get; set; } = default!;
    private List<CodeBrick> inactiveBricks = new List<CodeBrick>();
    private List<CodeBrick> activeBricks = new List<CodeBrick>();
    private static String vars = "";

    protected override async Task OnInitializedAsync(){
        inactiveBricks = new List<CodeBrick>();
        await GetStuff();
    }
    private async Task GetStuff() {
        Console.WriteLine("GetStuff() Started");
        await GM.GetTest();
        Console.WriteLine("GetTest() Recieved");
        List <CodeBrick> tempBricks = new List<CodeBrick>();
        Random rng = new Random();
        for (int i = 0; i < GM.codeblocks.Count; i++)
        {
            int varcount = GM.codeblocks[i].Length - GM.codeblocks[i].Replace("___", "__").Length;
            tempBricks.Add(new CodeBrick(GM.codeblocks[i], varcount));
        }
        inactiveBricks = new List<CodeBrick>();
        for (int j = 0; j < GM.codeblocks.Count; j++)
        {
            int ranId = rng.Next(0,tempBricks.Count);
            inactiveBricks.Add(tempBricks[ranId]);
            tempBricks.RemoveAt(ranId);
        }
        activeBricks = new List<CodeBrick>();
        Console.WriteLine("GetStuff() Finished");
        Console.WriteLine(inactiveBricks.Count + activeBricks.Count);
    }
    private void moveUp(int id)
    {
        if (id != 0) {
            CodeBrick temp = activeBricks[id];
            activeBricks[id] = activeBricks[id - 1];
            activeBricks[id - 1] = temp;
        }
    }
    private void moveDown(int id)
    {
        if (id != activeBricks.Count - 1) {
            CodeBrick temp = activeBricks[id];
            activeBricks[id] = activeBricks[id + 1];
            activeBricks[id + 1] = temp;
        }
    }
    private void activate(int id)
    {
        activeBricks.Add(inactiveBricks[id]);
        inactiveBricks.RemoveAt(id);
    }
    private void deactivate(int id)
    {
        inactiveBricks.Add(activeBricks[id]);
        activeBricks.RemoveAt(id);
    }
    private async Task CheckAnswer(){

        if(await GM.CheckAnswer(activeBricks)){
            NavMan.NavigateTo("/success");
        }else{
            NavMan.NavigateTo("/incorrect");
        }
    }
    public static void setVars(String v)
    {
        vars = v;
    }
}
