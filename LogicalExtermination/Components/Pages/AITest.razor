@page "/aitest"
@using Microsoft.Extensions.AI
@rendermode InteractiveServer

<PageTitle>AI Test</PageTitle>

<h1>AI Test</h1>

@if (output == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h2>Problem</h2>
    <p>@problem</p>
    <h2>Completed Code</h2>
    <p>@completed_code</p>
    <ul>
        <h2>Variables</h2>
        @foreach (var var in variables)
        {
            <li>@var</li>
        }
    </ul>
    <h2>Terminal Output</h2>
    <p>@terminal_out</p>
    <ul>
        <h2>Code Blocks</h2>
        @foreach (var block in codeblocks)
        {
            <li>@block</li>
        }
    </ul>
}

<button class="btn btn-primary" @onclick="GetTest">Reload</button>

@code {
    private Backend.OllamaManager ollama = new Backend.OllamaManager(Backend.Constants.OllamaConstants.qwencoder2_5_7b,new PythonRunner());
    private StructuredResult output = null;
    private string problem;
    private string completed_code;
    private List<string> variables;
    private string terminal_out;
    private List<string> codeblocks;
    private int difficultyScore=100;
    protected override async Task OnInitializedAsync()
    {
        //await GetTest();
    }

    private async Task GetTest()
    {
        Console.WriteLine("Running...");
        output=null;
        output = await ollama.GetStructuredResult();
        problem=output.Problem;
        completed_code=output.CompletedCode;
        codeblocks=output.Codeblocks;
        variables=output.Variables;
        terminal_out=output.TerminalOutput;
    }
}
