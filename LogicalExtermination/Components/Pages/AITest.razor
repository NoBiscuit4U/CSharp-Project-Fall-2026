@page "/aitest"
@rendermode InteractiveServer

<PageTitle>AI Test</PageTitle>

<h1>AI Test</h1>

@if (result == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p role="status">@result</p>
}

<button class="btn btn-primary" @onclick="GetTest">Reload</button>

@code {
    private Backend.OllamaManager ollama = new Backend.OllamaManager(Backend.Constants.OllamaConstants.gemma2b);
    private string result = null;
    protected override async Task OnInitializedAsync()
    {
        await GetTest();
    }

    private async Task GetTest()
    {
        result = null;
        result = await ollama.returntest();
    }
}
