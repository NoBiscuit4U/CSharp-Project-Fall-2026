@page "/incorrect"
@using System.Runtime.InteropServices
@rendermode InteractiveServer
@inject NavigationManager NavMan

<style> 
    .continue {
        background-color: rgb(16, 16, 16);
        color: white;
        font-size: 24px;
        padding: 10px 20px; <!-- vertical, horizontal -->
        margin: 10px;
        border: 2px solid white;
        border-radius: 16px;
    }
    .continue:hover {
        background-color: white;
        color: black;
        cursor: pointer;
    }.goOn {
        background-color: rgb(16, 16, 16);
        color: @MainLayout.getColor();
        font-size: 24px;
        padding: 10px 20px; <!-- vertical, horizontal -->
        margin: 10px;
        border: 2px solid white;
        border-radius: 16px;
    }
    .goOn:hover {
        background-color: white;
        color: black;
        cursor: pointer;
    }
</style>

<div class="content", style="boarder= 1px solid @bColor">
    <h1 style="color: rgb(255, 25, 25)">Incorrect</h1>
    <button class="continue" @onclick="() => Again()">Try Again</button>
    <button class="goOn" @onclick="() => IncDiff()">Decrease Difficulty</button>
</div>

@code {
    private string bColor = "rgb(255, 255, 255)";
    //    protected override async Task OnInitializedAsync(){
    //
    //        await Task.Delay(500);
    //        for (int t = 1; t <= 100; t++)
    //        {
    //            int g = ((235/100) * (100-t)) + 20;
    //            int b = ((235/100) * (100-t)) + 20;
    //            bColor = $"rgb(255, {g}, {b})";
    //            Console.WriteLine(bColor);
    //        }
    //    }
    private void Again()
    {
        Game.damage();
        MainLayout.updateHpColor();
        if (Game.getHealth() == 0) {
            NavMan.NavigateTo("/");
        }
        else
        {
            NavMan.NavigateTo("/play");
        }
    }
    private void IncDiff()
    {
        Game.damage();
        MainLayout.updateHpColor();
        if (Game.getDifficulty() > 5)
            Game.setDifficulty(Game.getDifficulty() - 5);
            MainLayout.updateDifColor();
        NavMan.NavigateTo("/play");
    }
}