@inherits LayoutComponentBase
@using LogicalExtermination.Components.Pages

<style>
    .text {
        text-align: right;
        align-content: right;
        color: white;
        padding: 25px;
        line-height: 0.75;
        grid-column-start: 2;
        grid-column-end: 4;
    }
</style>

<PageTitle>Logical Extermination</PageTitle>

<div class="segment">
    <div></div>
    <div class="text">
        <p>Health:</p>
        <p style="color: @hpColor; font-size: 48px;">@Game.getHealth()</p>
    </div>
    <div></div>
    <div>
        <div class="box px-10">
            <article class="content px-4">
                @Body
            </article>
        </div>
    </div>
    <div></div>
    <div></div>
    <div class="text">
        <p style="color: @difColor; font-size: 48px;">@Game.getDifficulty()</p>
        <p>Difficulty:</p>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    static private string difColor = "rgb(0, 200, 0)";
    static private string hpColor = "rgb(0, 200, 0)";
    protected override async Task OnInitializedAsync()
    {
        updateDifColor();
    }
    public static void updateDifColor()
    {
        int dif = Game.getDifficulty();
        int r = (255 * dif / 100);
        int g = (175 - (175 * dif / 100)) + 25;
        int b = (25 * dif / 100);
        difColor = $"rgb({r}, {g}, {b})";
    }
    public static void updateHpColor()
    {
        int hp = 5 - Game.getHealth();
        int r = (255 * hp / 5);
        int g = (175 - (175 * hp / 5)) + 25;
        int b = (25 * hp / 5);
        hpColor = $"rgb({r}, {g}, {b})";
    }
    public static string getColor()
    {
        return difColor;
    }
}