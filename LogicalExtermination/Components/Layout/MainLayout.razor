@inherits LayoutComponentBase
@using LogicalExtermination.Components.Pages

<style>
    .text {
        text-align: right;
        align-content: right;
        color: white;
        padding: 25px;
        line-height: 0.75;
        grid-column-start: 2;
        grid-column-end: 4;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 25px;
    }
    
</style>

<PageTitle>Logical Extermination</PageTitle>

<div class="segment">
    <div></div>
    <div class="text">
        <div>
            <p>Difficulty:</p>
            <p style="color: @GetDifficultyColor(GM.difficulty); font-size: 48px;">@GM.difficulty</p>
        </div>
        <div>
            <p>Health:</p>
            <p style="color: @GetHealthColor(GM.health); font-size: 48px;">@GM.health</p>
        </div>
    </div>
    <div></div>
    <div>
        <div class="box px-10">
            <article class="content px-4">
                @Body
            </article>
        </div>
    </div>
    <div></div>
    <div></div>
    <div></div>
    <div></div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    [Inject]
    private Backend.GameMode GM { get; set; } = default!;

    public static string GetDifficultyColor(int difficulty)
    {
        int r = (255 * difficulty / 100);
        int g = (175 - (175 * difficulty / 100)) + 25;
        int b = (25 * difficulty / 100);
        return $"rgb({r}, {g}, {b})";
    }

    private static string GetHealthColor(int health)
    {
        int hp = 5 - health;
        int r = (255 * hp / 5);
        int g = (175 - (175 * hp / 5)) + 25;
        int b = (25 * hp / 5);
        return $"rgb({r}, {g}, {b})";
    }
}